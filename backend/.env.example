# Copy this file to .env and fill in real values. Never commit .env itself.

# For quick local dev you can leave this as-is (SQLite file, zero setup).
# For real use, switch to Postgres, e.g.:
# DATABASE_URL=postgresql://username:password@localhost:5432/jeevandhara
DATABASE_URL=sqlite:///./jeevandhara.db

# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# Google Sign-In (server-side ID token verification)
# ---------------------------------------------------------------------------
# Web client ID (from Google Cloud Console -> Credentials -> OAuth 2.0 Client).
# Used both as the default audience and to allow the web build.
GOOGLE_CLIENT_ID=
# Android/iOS audience values so the same backend serves native apps.
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# Optional: extra comma-separated client IDs allowed as audiences.
GOOGLE_ALLOWED_CLIENT_IDS=

# ---------------------------------------------------------------------------
# Mobile OTP login (SMS delivery)
# ---------------------------------------------------------------------------
# APP_ENV=development  -> /auth/otp/send works with the console provider below.
# APP_ENV=production   -> OTP_SMS_PROVIDER=console is REJECTED (must use twilio).
APP_ENV=development

# Which SMS backend to use: "console" (dev only, prints code to server log),
# "twilio" or "msg91". Leave empty to auto-pick console in dev / none in production.
OTP_SMS_PROVIDER=msg91

# Twilio credentials (needed when OTP_SMS_PROVIDER=twilio).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio number in E.164 form, e.g. +12345678901
TWILIO_FROM_NUMBER=

# MSG91 credentials (needed when OTP_SMS_PROVIDER=msg91).
# Sign up at msg91.com -> grab the Authkey from Settings -> API & Settings.
# Create an OTP template (OTP section) and paste its ID here; the body must
# contain the OTP placeholder so the code is delivered.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Optional 6-char sender ID (defaults to MSG91's SMSIND if left empty).
MSG91_SENDER_ID=

# OTP lifecycle tuning (optional; defaults shown).
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=5
OTP_MIN_INTERVAL_SECONDS=30
OTP_RATE_WINDOW_SECONDS=3600
OTP_MAX_PER_WINDOW=5

# ---------------------------------------------------------------------------
# Real-time Weather module
# ---------------------------------------------------------------------------
# OPTIONAL. Leave this empty and the backend falls back to Open-Meteo, which
# needs no key and no signup — the app works out of the box.
#
# Set a key to switch to WeatherAPI.com, which is the richer provider:
#   get a free one at https://www.weatherapi.com/signup.aspx
#   free tier = current weather + place autocomplete + 3-day forecast
#   paid plans unlock the full 7-day forecast, UV alerts and severe-weather
#   alerts (Open-Meteo has no alert feed).
#
# Either way the key stays ONLY on the backend — the Flutter app calls our
# /weather API. The active provider is reported in the response's "source".
WEATHER_API_KEY=
# Optional: point at a different WeatherAPI-compatible host.
WEATHER_API_BASE=https://api.weatherapi.com/v1