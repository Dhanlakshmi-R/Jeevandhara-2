# Copy this file to .env and fill in real values. Never commit .env itself.

# For quick local dev you can leave this as-is (SQLite file, zero setup).
# For real use, switch to Postgres, e.g.:
# DATABASE_URL=postgresql://username:password@localhost:5432/jeevandhara
DATABASE_URL=sqlite:///./jeevandhara.db

# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
