    icon: Icons.biotech_outlined,
    color: const Color(0xFF5DAE54),
    onTap: (s) => s.widget.onAnalyzeQuality,
  ),
  _QuickActionSpec(
    title: 'Find Traders',
    subtitle: 'Matched buyers nearby',
    icon: Icons.handshake_outlined,
    color: const Color(0xFFF59E0B),
    onTap: (s) => s.widget.onNavigate(_DashboardPageState._tradersIdx),
  ),
  _QuickActionSpec(
    title: 'Rent Tools',
    subtitle: 'Tractors & equipment',
    icon: Icons.agriculture_outlined,
    color: const Color(0xFF2E86AB),
    onTap: (s) => s.widget.onNavigate(_DashboardPageState._rentToolsIdx),
  ),
];

class _DashboardGrid extends StatelessWidget {
  final Weather weather;
  final List<MarketPrice> prices;
  final VoidCallback onWeatherMore;
  final VoidCallback onViewMarket;

  const _DashboardGrid({
    required this.weather,
    required this.prices,
    required this.onWeatherMore,
    required this.onViewMarket,
  });

  @override
  Widget build(BuildContext context) {
    final c = context.colors;
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        SectionHeader(
          title: context.str(K.weatherSummary, fallback: 'Weather Summary'),
          actionLabel: 'Details',
          actionIcon: Icons.arrow_forward,
          onAction: onWeatherMore,
        ),
        const SizedBox(height: 10),
        WeatherCard(weather: weather, onMore: onWeatherMore),
        const SizedBox(height: 20),
        SectionHeader(
          title: context.str(K.liveMarketPrices, fallback: 'Live Market Prices'),
          actionLabel: 'View all',
          actionIcon: Icons.trending_up,
          onAction: onViewMarket,
        ),
        const SizedBox(height: 10),
        SizedBox(
          height: 128,
          child: ListView.separated(
            scrollDirection: Axis.horizontal,
            itemCount: prices.length,
            separatorBuilder: (_, _) => const SizedBox(width: 12),
            itemBuilder: (context, i) => _MiniPriceCard(price: prices[i]),
          ),
        ),
      ],
    );
  }
}

class _MiniPriceCard extends StatelessWidget {
  final MarketPrice price;
  const _MiniPriceCard({required this.price});

  @override
  Widget build(BuildContext context) {
    final c = context.colors;
    final trendColor = price.isRising ? c.positive : c.negative;
    return Container(
      width: 200,
      padding: const EdgeInsets.all(14),
      decoration: BoxDecoration(
        color: c.surface,
        borderRadius: BorderRadius.circular(16),
        border: Border.all(color: c.border),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Text(price.emoji, style: const TextStyle(fontSize: 22)),
              const Spacer(),
              StatusBadge(
                text: price.changePercent >= 0 ? '▲ ${price.changePercent.toStringAsFixed(1)}%' : '▼ ${price.changePercent.abs().toStringAsFixed(1)}%',
                color: trendColor,
              ),
            ],
          ),
          const Spacer(),
          Text(
            price.crop,
            style: TextStyle(fontSize: 14, fontWeight: FontWeight.w600, color: c.textPrimary),
          ),
          Text(
            price.priceLabel,
            style: TextStyle(fontSize: 15, fontWeight: FontWeight.w800, color: c.primaryDark),
          ),
        ],
      ),
    );
  }
}

class _RecentSection extends StatelessWidget {
  final String cropsTitle;
  final String offersTitle;
  final VoidCallback onViewMyCrops;
  final VoidCallback onViewTraders;

  const _RecentSection({
    required this.cropsTitle,
    required this.offersTitle,
    required this.onViewMyCrops,
    required this.onViewTraders,
  });

  @override
  Widget build(BuildContext context) {
    return LayoutBuilder(
      builder: (context, constraints) {
        final sideBySide = constraints.maxWidth >= 840;
        final listingCard = _ListingsCard(onView: onViewMyCrops);
        final offersCard = _OffersCard(onView: onViewTraders);

        if (sideBySide) {
          return Row(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Expanded(child: listingCard),
              const SizedBox(width: 14),
              Expanded(child: offersCard),
            ],
          );
        }
        return Column(
          children: [
            listingCard,
            const SizedBox(height: 14),
            offersCard,
          ],
        );
      },
    );
  }
}

class _ListingsCard extends StatelessWidget {
  final VoidCallback onView;
  const _ListingsCard({required this.onView});

  @override
  Widget build(BuildContext context) {
    final c = context.colors;
    final crops = CropListingSample.samples;
    return AppCard(
      padding: const EdgeInsets.all(16),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              Text(
                context.str(K.recentListings, fallback: 'Recent Crop Listings'),
                style: const TextStyle(fontSize: 15, fontWeight: FontWeight.w700),
              ),
              TextButton(onPressed: onView, child: const Text('View all')),
            ],
          ),
          const Divider(),
          for (final crop in crops) _CropRow(crop: crop),
        ],
      ),
    );
  }
}

class CropListingSample {
  static const samples = [
    CropRowData('🍅', 'Tomato', '250 kg', 'Active', '₹28/kg'),
    CropRowData('🌾', 'Wheat', '5 quintal', 'Offer received', '₹2,200/q'),
    CropRowData('🧅', 'Onion', '1 quintal', 'Sold', '₹36/kg'),
  ];
}

class CropRowData {
  final String emoji;
  final String name;
  final String qty;
  final String status;
  final String price;
  const CropRowData(this.emoji, this.name, this.qty, this.status, this.price);
}

class _CropRow extends StatelessWidget {
  final CropRowData crop;
  const _CropRow({required this.crop});

  @override
  Widget build(BuildContext context) {
    final c = context.colors;
    final statusColor = crop.status == 'Sold'
        ? c.textSecondary
        : crop.status == 'Offer received'
            ? c.accent
            : c.positive;
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 8),
      child: Row(
        children: [
          Text(crop.emoji, style: const TextStyle(fontSize: 22)),
          const SizedBox(width: 10),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  crop.name,
                  style: const TextStyle(fontSize: 13.5, fontWeight: FontWeight.w600),
                ),
                Text(crop.qty, style: TextStyle(fontSize: 11.5, color: c.textSecondary)),
              ],
            ),
          ),
          Column(
            crossAxisAlignment: CrossAxisAlignment.end,
            children: [
              Text(crop.price, style: const TextStyle(fontSize: 13, fontWeight: FontWeight.w700)),
              const SizedBox(height: 2),
              StatusBadge(text: crop.status, color: statusColor),
            ],
          ),
        ],
      ),
    );
  }
}

class _OffersCard extends StatelessWidget {
  final VoidCallback onView;
  const _OffersCard({required this.onView});

  @override
  Widget build(BuildContext context) {
    final c = context.colors;
    final offers = Trader.sampleData().take(3).toList();
    return AppCard(
      padding: const EdgeInsets.all(16),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              Text(
                context.str(K.recentOffers, fallback: 'Recent Trader Offers'),
                style: const TextStyle(fontSize: 15, fontWeight: FontWeight.w700),
              ),
              TextButton(onPressed: onView, child: const Text('View all')),
            ],
          ),
          const Divider(),
          for (final trader in offers) _OfferRow(trader: trader),
        ],
      ),
    );
  }
}

class _OfferRow extends StatelessWidget {
  final Trader trader;
  const _OfferRow({required this.trader});

  @override
  Widget build(BuildContext context) {
    final c = context.colors;
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 8),
      child: Row(
        children: [
          Text(trader.emoji, style: const TextStyle(fontSize: 20)),
          const SizedBox(width: 10),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  trader.name,
                  style: const TextStyle(fontSize: 13.5, fontWeight: FontWeight.w600),
                ),
                Text(
                  '${trader.cropType} · ${trader.distance}',
                  style: TextStyle(fontSize: 11.5, color: c.textSecondary),
                ),
              ],
            ),
          ),
          StatusBadge(
            text: trader.offeredPrice,
            color: c.positive,
            icon: Icons.currency_rupee_rounded,
          ),
        ],
      ),
    );
  }
}

class _TipCard extends StatelessWidget {
  const _TipCard();

